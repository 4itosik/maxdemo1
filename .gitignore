# ============================================================
#  Объединённый .gitignore
#  Собран из .gitignore трёх проектов: maxapi, maxbotdemo, maxmoc.
#  Правила, привязанные к корню репозитория (со слэша), перенесены
#  вместе с именем подпапки, чтобы сохранить исходную область действия.
# ============================================================

# --- Секреты (было в maxbotdemo, применяем ко всем подпроектам) ---
.env
.env.*

# --- macOS (было в maxapi и maxbotdemo) ---
.DS_Store

# --- Рабочие каталоги агента (нигде не отслеживались) ---
.superpowers/

# --- Зависимости и кодогенерация — maxapi ---
node_modules/
tsp-output/
__pycache__/

# Промежуточная JSON Schema для quicktype: единственный её потребитель —
# `npm run gen:go`, а результат (maxapi/gen/go/models.go) в git есть.
# Готовые контракты maxapi/openapi.*.yaml НЕ игнорируются намеренно.
/maxapi/gen/max.schema.json

# Отчёт `make compare-gen`: целиком выводится из двух models.go, которые в git.
/maxapi/gen/compare.json


# --- Артефакты сборки — maxbotdemo (было: /bot, /bin/) ---
/maxbotdemo/bot
/maxbotdemo/bin/

# --- Артефакты сборки — maxmoc (было: /max-mock, /blobs/) ---
/maxmoc/max-mock
/maxmoc/blobs/

# --- Базы данных SQLite — maxmoc (правило оставлено глобальным) ---
*.db
*.db-wal
*.db-shm
